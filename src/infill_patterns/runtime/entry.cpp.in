// The entry point of @ORCA_INFILL_LIBRARY@, which serves the row @ORCA_INFILL_ROW@ of the built-in infill pattern table
// with @ORCA_INFILL_CLASS@. Generated by orca_add_builtin_infill_library() (src/infill_patterns/CMakeLists.txt).
#include "PatternEntry.hpp"
#include "orca_infill_build_id.h"

#include "@ORCA_INFILL_HEADER@"

namespace {

struct Row
{
    using Filler = Slic3r::@ORCA_INFILL_CLASS@;
    static constexpr int32_t     pattern     = int32_t(Slic3r::@ORCA_INFILL_ROW@);
    static constexpr const char *key         = @ORCA_INFILL_KEY@;
    static constexpr const char *name        = "@ORCA_INFILL_LIBRARY@";
    static constexpr const char *build_id    = ORCA_INFILL_BUILD_ID;
    static constexpr uint32_t    calls       = @ORCA_INFILL_CALLS@;
    static constexpr uint32_t    traits      = @ORCA_INFILL_TRAITS@;
    static constexpr uint32_t    state_kinds = @ORCA_INFILL_STATE_KINDS@;
};

} // namespace

extern "C" @ORCA_INFILL_ENTRY_EXPORT@ const orca_infill_builtin_library *ORCA_INFILL_CALL @ORCA_INFILL_ENTRY@(const orca_infill_builtin_host *host)
{
    return Slic3r::PatternLibrary::PatternEntry<Row>::bind(host);
}
